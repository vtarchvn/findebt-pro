{
  "name": "findebt-pro",
  "version": "2.2.0",
  "private": true,
  "description": "FINDEBT PRO - Vietnamese receivables and payables management on Google Apps Script",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "push": "npm run build && clasp push",
    "deploy": "npm run build && clasp deploy",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@google/clasp": "^3.0.6-alpha",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
